{
  "name": "dir-echoes-voice-router",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 13300",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "launch": "tsx --env-file-if-exists=.env.local scripts/launch.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env.local --test tests/*.test.ts",
    "db:import": "tsx --env-file=.env.local scripts/import-dataset.ts",
    "evaluate": "tsx --env-file=.env.local scripts/evaluate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "openai": "^7.21.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
