# Server-side only. Fill locally or in Vercel environment variables.
OPENAI_API_KEY=
ROUTER_MODEL=gpt-4.1-mini-2025-04-14
STT_MODEL=gpt-transcribe
TTS_MODEL=gpt-4o-mini-tts
DATABASE_URL=
SESSION_SECRET=
SUPERVISOR_ACCESS_CODE=
PARTICIPANT_ACCESS_CODE=
# The organizer requires relative dates to use the dataset reference date.
BUSINESS_DATE=2026-10-01
# Local path to the organizer's original dataset; never a public asset directory.
DATASET_PATH=
# Application accounting cap (USD/day); separate from provider-side billing limits.
MAX_AI_SPEND_USD=5
# Optional durable local PostgreSQL fallback for development only.
LOCAL_DATABASE_PATH=
